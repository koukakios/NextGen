// --------------------------------------------------
// Movement mapping
// --------------------------------------------------

bool getTargetsForMotion(MotionState wantedMotion, float &left, float &right) {
  float driveDuty = getDriveDuty();
  float reverseDuty = getReverseDuty();
  float turnDuty = getTurnDuty();

  switch (wantedMotion) {
    case FORWARD:
      left = driveDuty;
      right = driveDuty;
      return true;

    case REVERSE:
      left = -reverseDuty;
      right = -reverseDuty;
      return true;

    case LEFT:
      left = -turnDuty;
      right = turnDuty;
      return true;

    case RIGHT:
      left = turnDuty;
      right = -turnDuty;
      return true;

    case STOPPED:
      left = 0.0f;
      right = 0.0f;
      return true;

    default:
      left = 0.0f;
      right = 0.0f;
      return false;
  }
}

// --------------------------------------------------
// Motor state functions
// --------------------------------------------------

void rawStopMotors() {
  leftTarget = 0.0f;
  rightTarget = 0.0f;
  motion = STOPPED;

  sendLeftCommand(0.0f);
  sendRightCommand(0.0f);

  pcEvent("MOTORS_STOPPED");
}

void stopMotors() {
  transitionPending = false;
  rawStopMotors();
}

void applyMotors(float left, float right, MotionState newMotion) {
  leftTarget = left;
  rightTarget = right;
  motion = newMotion;

  sendLeftCommand(leftTarget);
  sendRightCommand(rightTarget);

  PC_SERIAL.print("<EVT,MOTION=");
  PC_SERIAL.print(motionToString(motion));
  PC_SERIAL.print(",L=");
  PC_SERIAL.print(leftTarget, 3);
  PC_SERIAL.print(",R=");
  PC_SERIAL.print(rightTarget, 3);
  PC_SERIAL.println(">");
}

void requestMotion(float left, float right, MotionState newMotion) {
  if (!driveEnabled) {
    pcErr("DRIVE_NOT_ENABLED_INTERNAL");
    return;
  }

  if (!modeSelected && newMotion != STOPPED) {
    pcErr("MODE_NOT_SELECTED_INTERNAL");
    return;
  }

  if (!DRY_RUN && !canReady) {
    pcErr("CAN_NOT_READY_MOTION_BLOCKED");
    return;
  }

  if (canFaultLatched) {
    pcErr("CAN_FAULT_LATCHED_MOTION_BLOCKED");
    return;
  }

  if (transitionPending) {
    pendingLeftTarget = left;
    pendingRightTarget = right;
    pendingMotion = newMotion;

    PC_SERIAL.print("<EVT,PENDING_REPLACED,MOTION=");
    PC_SERIAL.print(motionToString(pendingMotion));
    PC_SERIAL.println(">");

    return;
  }

  if (motion == STOPPED) {
    applyMotors(left, right, newMotion);
    return;
  }

  if (motion == newMotion) {
    applyMotors(left, right, newMotion);
    return;
  }

  PC_SERIAL.print("<EVT,MOTION_CHANGE,FROM=");
  PC_SERIAL.print(motionToString(motion));
  PC_SERIAL.print(",TO=");
  PC_SERIAL.print(motionToString(newMotion));
  PC_SERIAL.println(">");

  rawStopMotors();

  pendingLeftTarget = left;
  pendingRightTarget = right;
  pendingMotion = newMotion;

  transitionPending = true;
  transitionStartMs = millis();
}

void requestMotionState(MotionState wantedMotion) {
  float left = 0.0f;
  float right = 0.0f;

  if (!getTargetsForMotion(wantedMotion, left, right)) {
    pcErr("INVALID_MOTION");
    return;
  }

  requestMotion(left, right, wantedMotion);
}

void processPendingTransition() {
  if (!transitionPending) {
    return;
  }

  if (!driveEnabled) {
    transitionPending = false;
    return;
  }

  if (millis() - transitionStartMs >= STOP_BEFORE_CHANGE_MS) {
    transitionPending = false;
    applyMotors(pendingLeftTarget, pendingRightTarget, pendingMotion);
  }
}

// --------------------------------------------------
// Internal drive control
// --------------------------------------------------

bool internalEnableDrive() {
  if (!DRY_RUN && !canReady) {
    pcErr("CAN_NOT_READY_ENABLE_BLOCKED");
    return false;
  }

  if (canFaultLatched) {
    pcErr("CAN_FAULT_LATCHED_ENABLE_BLOCKED");
    return false;
  }

  driveEnabled = true;
  modeSelected = true;
  timeoutLatched = false;
  emergencyLatched = false;

  setMotorRelay(true);
  markValidMovementCommand();

  return true;
}

void internalDisableDrive(const char* reason) {
  transitionPending = false;

  // Safety order:
  // 1. Drop relay/brakes first.
  // 2. Then try to send zero duty.
  driveEnabled = false;
  modeSelected = false;
  setMotorRelay(false);

  stopMotors();

  PC_SERIAL.print("<EVT,DRIVE_DISABLED,REASON=");
  PC_SERIAL.print(reason);
  PC_SERIAL.println(">");
}

void forceDisableDriveNoCanStop(const char* reason) {
  transitionPending = false;

  leftTarget = 0.0f;
  rightTarget = 0.0f;
  motion = STOPPED;

  driveEnabled = false;
  modeSelected = false;

  setMotorRelay(false);

  PC_SERIAL.print("<WARN,DRIVE_FORCE_DISABLED,REASON=");
  PC_SERIAL.print(reason);
  PC_SERIAL.println(">");
}

void setDrivingModeInternal(DrivingMode newMode) {
  drivingMode = newMode;
  modeSelected = true;

  PC_SERIAL.print("<EVT,MODE=");
  PC_SERIAL.print(drivingModeToString(drivingMode));
  PC_SERIAL.print(",BASE_DUTY=");
  PC_SERIAL.print(getDriveDuty(), 3);
  PC_SERIAL.println(">");
}

void handleCanFaultShutdown() {
  if (!canFaultLatched) {
    return;
  }

  if (driveEnabled || motorRelayActive) {
    forceDisableDriveNoCanStop("CAN_TX_FAULT");
  }
}

// --------------------------------------------------
// Binary PC command handler
// --------------------------------------------------

void handleBinaryCommand(uint8_t rawByte) {
  // Only accept values 0 to 7.
  // This prevents normal ASCII text from being treated as motion commands.
  if (rawByte > 0x07) {
    return;
  }

  uint8_t cmd = rawByte & 0x07;

  switch (cmd) {
    case CMD_STOP:
      timeoutLatched = false;
      emergencyLatched = false;
      canFaultLatched = false;
      internalDisableDrive("BIN_STOP");
      pcAck("BIN,STOP");
      return;

    case CMD_MODE_1:
      setDrivingModeInternal(MODE_1);
      if (!internalEnableDrive()) {
        return;
      }
      requestMotionState(FORWARD);
      pcAck("BIN,MODE1_FORWARD");
      return;

    case CMD_MODE_2:
      setDrivingModeInternal(MODE_2);
      if (!internalEnableDrive()) {
        return;
      }
      requestMotionState(FORWARD);
      pcAck("BIN,MODE2_FORWARD");
      return;

    case CMD_MODE_3:
      setDrivingModeInternal(MODE_3);
      if (!internalEnableDrive()) {
        return;
      }
      requestMotionState(FORWARD);
      pcAck("BIN,MODE3_FORWARD");
      return;

    case CMD_RIGHT:
      if (!modeSelected) {
        setDrivingModeInternal(MODE_1);
      }

      if (!internalEnableDrive()) {
        return;
      }

      requestMotionState(RIGHT);
      pcAck("BIN,RIGHT");
      return;

    case CMD_LEFT:
      if (!modeSelected) {
        setDrivingModeInternal(MODE_1);
      }

      if (!internalEnableDrive()) {
        return;
      }

      requestMotionState(LEFT);
      pcAck("BIN,LEFT");
      return;

    case CMD_STATUS:
      sendStatusFrame();
      return;

    case CMD_ESTOP:
      transitionPending = false;

      // ESTOP safety order:
      // Drop relay first, then try zero-duty CAN.
      driveEnabled = false;
      modeSelected = false;
      timeoutLatched = false;
      emergencyLatched = true;
      canFaultLatched = false;

      setMotorRelay(false);
      stopMotors();

      pcWarn("BIN_ESTOP");
      pcAck("BIN,ESTOP");
      return;

    default:
      pcErr("BIN_UNKNOWN");
      return;
  }
}

// --------------------------------------------------
// Serial receiving
// --------------------------------------------------

void readPcSerial() {
  while (PC_SERIAL.available() > 0) {
    uint8_t rawByte = uint8_t(PC_SERIAL.read());
    handleBinaryCommand(rawByte);
  }
}

// --------------------------------------------------
// PC timeout
// --------------------------------------------------

void checkPcTimeout() {
  if (!driveEnabled) {
    return;
  }

  unsigned long now = millis();

  if (now - lastValidMovementCommandMs > PC_TIMEOUT_MS) {
    transitionPending = false;

    // Safety order:
    // Drop relay/brakes first, then try zero-duty CAN.
    driveEnabled = false;
    modeSelected = false;
    timeoutLatched = true;

    setMotorRelay(false);
    stopMotors();

    pcWarn("PC_TIMEOUT_500MS");
    pcEvent("DRIVE_DISABLED_AFTER_TIMEOUT");
  }
}

// --------------------------------------------------
// Setup and loop
// --------------------------------------------------

void setup() {
  PC_SERIAL.begin(115200);
  while (!PC_SERIAL) {;}

  setupMotorRelay();

  canReady = setupCan();

  lastValidMovementCommandMs = millis();

  PC_SERIAL.println();
  PC_SERIAL.println("<BOOT,CHAIR_CAN_RAW_BYTE_TEST_READY>");
  PC_SERIAL.println("<BOOT,THIS_USES_SAME_RAW_BYTE_LOGIC_AS_UART>");
  PC_SERIAL.println("<BOOT,0x00=STOP>");
  PC_SERIAL.println("<BOOT,0x01=MODE1_FORWARD>");
  PC_SERIAL.println("<BOOT,0x02=MODE2_FORWARD>");
  PC_SERIAL.println("<BOOT,0x03=MODE3_FORWARD>");
  PC_SERIAL.println("<BOOT,0x04=RIGHT>");
  PC_SERIAL.println("<BOOT,0x05=LEFT>");
  PC_SERIAL.println("<BOOT,0x06=STATUS>");
  PC_SERIAL.println("<BOOT,0x07=ESTOP>");

  PC_SERIAL.print("<BOOT,LEFT_VESC_ID=");
  PC_SERIAL.print(LEFT_VESC_ID);
  PC_SERIAL.println(">");

  PC_SERIAL.print("<BOOT,RIGHT_VESC_ID=");
  PC_SERIAL.print(RIGHT_VESC_ID);
  PC_SERIAL.println(">");

  PC_SERIAL.print("<BOOT,CAN_BITRATE=");
  PC_SERIAL.print(CAN_BITRATE);
  PC_SERIAL.println(">");

  PC_SERIAL.println("<BOOT,CAN_PERIPHERAL=FDCAN2>");
  PC_SERIAL.println("<BOOT,CAN_TX_PIN=PB13>");
  PC_SERIAL.println("<BOOT,CAN_RX_PIN=PB5>");

  PC_SERIAL.print("<BOOT,CAN_STBY_PIN=D");
  PC_SERIAL.print(CAN_STBY_PIN);
  PC_SERIAL.println(">");

  PC_SERIAL.print("<BOOT,EXPECTED_COMMAND_PERIOD_MS=");
  PC_SERIAL.print(EXPECTED_PC_COMMAND_PERIOD_MS);
  PC_SERIAL.println(">");

  PC_SERIAL.print("<BOOT,TIMEOUT_MS=");
  PC_SERIAL.print(PC_TIMEOUT_MS);
  PC_SERIAL.println(">");

  PC_SERIAL.print("<BOOT,TEST_DUTY_MODE1=");
  PC_SERIAL.print(DUTY_MODE_1, 3);
  PC_SERIAL.println(">");

  PC_SERIAL.print("<BOOT,TEST_DUTY_MODE2=");
  PC_SERIAL.print(DUTY_MODE_2, 3);
  PC_SERIAL.println(">");

  PC_SERIAL.print("<BOOT,TEST_DUTY_MODE3=");
  PC_SERIAL.print(DUTY_MODE_3, 3);
  PC_SERIAL.println(">");

  PC_SERIAL.print("<BOOT,DRY_RUN=");
  PC_SERIAL.print(DRY_RUN ? 1 : 0);
  PC_SERIAL.println(">");

  if (!canReady && !DRY_RUN) {
    pcWarn("CAN_NOT_READY_OUTPUT_DISABLED");
  }

  rawStopMotors();
  setMotorRelay(false);
  sendStatusFrame();
}

void loop() {
  readPcSerial();

  readCan();

  processPendingTransition();

  checkPcTimeout();

  if (driveEnabled && (millis() - lastKeepAliveMs > KEEPALIVE_MS)) {
    lastKeepAliveMs = millis();
    refreshVescCommandsBoth();
  }

  handleCanFaultShutdown();
}