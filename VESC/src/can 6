#include <Arduino.h>
#include <math.h>
#include <string.h>

// --------------------------------------------------
// Wheelchair RAW-BYTE TEST for 2 VESCs over CAN
// Arduino GIGA + NEXT GIGA shield + MCP2562
//
// Same PC protocol as your working UART code:
//
// PC sends ONE RAW BYTE:
//
//   0b000 = 0x00 = stop
//   0b001 = 0x01 = driving mode 1 forward
//   0b010 = 0x02 = driving mode 2 forward
//   0b011 = 0x03 = driving mode 3 forward
//   0b100 = 0x04 = right
//   0b101 = 0x05 = left
//   0b110 = 0x06 = status
//   0b111 = 0x07 = emergency stop
//
// NEXT GIGA shield:
//   CANRX/CANTX header pins use FDCAN2.
//   CANRX = D93 = PB5
//   CANTX = D94 = PB13
//   MCP2562 STBY = D7
//
// VESC relay/brake release:
//   DS-9 pin 4 = Analog 1 on GIGA shield.
//   A1 LOW activates relay/brake release.
//
// Safety:
//   - Movement command automatically enables drive.
//   - Stop command drops relay first, then sends zero duty.
//   - If no valid movement command is received for 500 ms,
//     motors stop and relay disables.
//   - ESTOP stops motors and disables relay.
// --------------------------------------------------

#ifndef ARDUINO_GIGA
#error This sketch is intended for Arduino GIGA R1 WiFi.
#endif

// --------------------------------------------------
// ACANFD_GIGA_R1 setup
// --------------------------------------------------
// NEXT shield uses FDCAN2, not FDCAN1.

static const uint32_t FDCAN1_MESSAGE_RAM_WORD_SIZE = 0;
static const uint32_t FDCAN2_MESSAGE_RAM_WORD_SIZE = 2560;

#include <ACANFD_GIGA_R1.h>

#define VESC_CAN fdcan2

// --------------------------------------------------
// Software-only test switch
// --------------------------------------------------

constexpr bool DRY_RUN = false;

// --------------------------------------------------
// PC communication port
// --------------------------------------------------

#define PC_SERIAL Serial

// --------------------------------------------------
// CAN settings
// --------------------------------------------------

constexpr uint32_t CAN_BITRATE = 500000;

// These must match VESC Tool CAN IDs.
constexpr uint8_t LEFT_VESC_ID = 1;
constexpr uint8_t RIGHT_VESC_ID = 2;

// NEXT shield MCP2562 standby pin.
// MCP2562 STBY LOW  = normal CAN operation.
// MCP2562 STBY HIGH = standby.
constexpr uint8_t CAN_STBY_PIN = 7;
constexpr uint8_t CAN_STBY_NORMAL_LEVEL = LOW;
constexpr uint8_t CAN_STBY_STANDBY_LEVEL = HIGH;

bool canReady = false;
bool canFaultLatched = false;

uint32_t lastCanTxStatus = 0;
uint32_t canTxFailCount = 0;
uint32_t canRxCount = 0;

// --------------------------------------------------
// VESC CAN packet IDs
// --------------------------------------------------
// VESC CAN extended ID:
//   extended_id = (packet_id << 8) | vesc_can_id

constexpr uint32_t CAN_PACKET_SET_DUTY = 0;
constexpr uint32_t CAN_PACKET_STATUS = 9;
constexpr uint32_t CAN_PACKET_STATUS_5 = 27;

// --------------------------------------------------
// Motor relay / brake release
// --------------------------------------------------

constexpr uint8_t MOTOR_RELAY_PIN = A1;
constexpr uint8_t MOTOR_RELAY_ACTIVE_LEVEL = LOW;
constexpr uint8_t MOTOR_RELAY_INACTIVE_LEVEL = HIGH;

bool motorRelayActive = false;

// --------------------------------------------------
// Timing
// --------------------------------------------------

constexpr unsigned long EXPECTED_PC_COMMAND_PERIOD_MS = 50;
constexpr unsigned long PC_TIMEOUT_MS = 500;

// CAN command refresh.
// 20 ms = 50 Hz.
constexpr unsigned long KEEPALIVE_MS = 20;

constexpr unsigned long STOP_BEFORE_CHANGE_MS = 150;

// --------------------------------------------------
// Motion and mode states
// --------------------------------------------------

enum MotionState {
  STOPPED,
  FORWARD,
  REVERSE,
  LEFT,
  RIGHT
};

enum DrivingMode {
  MODE_1,
  MODE_2,
  MODE_3
};

enum BinaryCommand {
  CMD_STOP   = 0b000,
  CMD_MODE_1 = 0b001,
  CMD_MODE_2 = 0b010,
  CMD_MODE_3 = 0b011,
  CMD_RIGHT  = 0b100,
  CMD_LEFT   = 0b101,
  CMD_STATUS = 0b110,
  CMD_ESTOP  = 0b111
};

bool driveEnabled = false;
bool modeSelected = false;
bool timeoutLatched = false;
bool emergencyLatched = false;

MotionState motion = STOPPED;
DrivingMode drivingMode = MODE_1;

float leftTarget = 0.0f;
float rightTarget = 0.0f;

unsigned long lastValidMovementCommandMs = 0;
unsigned long lastKeepAliveMs = 0;

bool transitionPending = false;
unsigned long transitionStartMs = 0;

float pendingLeftTarget = 0.0f;
float pendingRightTarget = 0.0f;
MotionState pendingMotion = STOPPED;

// --------------------------------------------------
// TEST duty presets
// --------------------------------------------------
// These are intentionally low for first CAN testing.
// After confirming direction and safety, increase carefully.

constexpr float DUTY_MODE_1 = 0.30f;
constexpr float DUTY_MODE_2 = 0.40f;
constexpr float DUTY_MODE_3 = 0.50f;

constexpr float TURN_DUTY_FACTOR = 0.80f;
constexpr float REVERSE_DUTY_FACTOR = 0.70f;

// --------------------------------------------------
// Telemetry cache from VESC CAN status frames
// --------------------------------------------------

struct VescTelemetryCache {
  bool seenStatus = false;
  bool seenStatus5 = false;
  unsigned long lastRxMs = 0;
  int32_t rpm = 0;
  float current = 0.0f;
  float duty = 0.0f;
  float vin = 0.0f;
};

VescTelemetryCache leftTel;
VescTelemetryCache rightTel;

// --------------------------------------------------
// Helper functions
// --------------------------------------------------

const char* motionToString(MotionState s) {
  switch (s) {
    case STOPPED: return "STOP";
    case FORWARD: return "FORWARD";
    case REVERSE: return "REVERSE";
    case LEFT:    return "LEFT";
    case RIGHT:   return "RIGHT";
    default:      return "UNKNOWN";
  }
}

const char* drivingModeToString(DrivingMode m) {
  switch (m) {
    case MODE_1: return "MODE1";
    case MODE_2: return "MODE2";
    case MODE_3: return "MODE3";
    default:     return "UNKNOWN";
  }
}

float getDriveDuty() {
  switch (drivingMode) {
    case MODE_1:
      return DUTY_MODE_1;

    case MODE_2:
      return DUTY_MODE_2;

    case MODE_3:
      return DUTY_MODE_3;

    default:
      return DUTY_MODE_1;
  }
}

float getTurnDuty() {
  return getDriveDuty() * TURN_DUTY_FACTOR;
}

float getReverseDuty() {
  return getDriveDuty() * REVERSE_DUTY_FACTOR;
}

void markValidMovementCommand() {
  lastValidMovementCommandMs = millis();
}

int16_t readInt16BE(const uint8_t* data) {
  return int16_t((uint16_t(data[0]) << 8) | uint16_t(data[1]));
}

int32_t readInt32BE(const uint8_t* data) {
  return int32_t(
    (uint32_t(data[0]) << 24) |
    (uint32_t(data[1]) << 16) |
    (uint32_t(data[2]) << 8) |
    uint32_t(data[3])
  );
}

void writeInt32BE(uint8_t* data, int32_t value) {
  data[0] = uint8_t((uint32_t(value) >> 24) & 0xFF);
  data[1] = uint8_t((uint32_t(value) >> 16) & 0xFF);
  data[2] = uint8_t((uint32_t(value) >> 8) & 0xFF);
  data[3] = uint8_t(uint32_t(value) & 0xFF);
}

uint32_t makeVescCanId(uint32_t packetId, uint8_t vescId) {
  return ((packetId & 0x1FFFFF) << 8) | uint32_t(vescId);
}

uint32_t getVescPacketIdFromCanId(uint32_t extendedId) {
  return extendedId >> 8;
}

uint8_t getVescSourceIdFromCanId(uint32_t extendedId) {
  return uint8_t(extendedId & 0xFF);
}

float clampDuty(float duty) {
  if (duty > 0.95f) {
    return 0.95f;
  }

  if (duty < -0.95f) {
    return -0.95f;
  }

  return duty;
}

uint32_t getCanFlags() {
  if (DRY_RUN || !canReady) {
    return 0;
  }

  return VESC_CAN.statusFlags();
}

