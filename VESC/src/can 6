// --------------------------------------------------
// Relay helpers
// --------------------------------------------------

void setMotorRelay(bool active) {
  if (DRY_RUN) {
    motorRelayActive = false;
    PC_SERIAL.print("<DRY,MOTOR_RELAY_REQUEST=");
    PC_SERIAL.print(active ? 1 : 0);
    PC_SERIAL.println(">");
    return;
  }

  digitalWrite(
    MOTOR_RELAY_PIN,
    active ? MOTOR_RELAY_ACTIVE_LEVEL : MOTOR_RELAY_INACTIVE_LEVEL
  );

  motorRelayActive = active;

  PC_SERIAL.print("<EVT,MOTOR_RELAY=");
  PC_SERIAL.print(motorRelayActive ? 1 : 0);
  PC_SERIAL.println(">");
}

void setupMotorRelay() {
  digitalWrite(MOTOR_RELAY_PIN, MOTOR_RELAY_INACTIVE_LEVEL);
  pinMode(MOTOR_RELAY_PIN, OUTPUT);
  digitalWrite(MOTOR_RELAY_PIN, MOTOR_RELAY_INACTIVE_LEVEL);

  motorRelayActive = false;
  PC_SERIAL.println("<BOOT,MOTOR_RELAY_OFF>");
}

// --------------------------------------------------
// CAN setup
// --------------------------------------------------

void setupCanTransceiver() {
  pinMode(CAN_STBY_PIN, OUTPUT);

  // Release MCP2562 from standby.
  digitalWrite(CAN_STBY_PIN, CAN_STBY_NORMAL_LEVEL);
  delay(10);

  PC_SERIAL.println("<BOOT,CAN_TRANSCEIVER_STBY_LOW>");
}

bool setupCan() {
  if (DRY_RUN) {
    PC_SERIAL.println("<BOOT,CAN_DRY_RUN>");
    return true;
  }

  setupCanTransceiver();

  ACANFD_GIGA_R1_Settings settings(CAN_BITRATE, DataBitRateFactor::x1);

  // Important for testing:
  // If no VESC acknowledges a frame, do not keep retransmitting forever.
  // This prevents the TX FIFO from clogging and spamming STATUS=0x3.
  settings.mEnableRetransmission = false;

  // Use STM32 FDCAN peripheral, but send classic CAN frames.
  settings.mModuleMode = ACANFD_GIGA_R1_Settings::NORMAL_FD;

  settings.mHardwareRxFIFO0Size = 20;
  settings.mHardwareRxFIFO0Payload = ACANFD_GIGA_R1_Settings::PAYLOAD_8_BYTES;
  settings.mHardwareRxFIFO1Size = 0;

  settings.mHardwareTransmitTxFIFOSize = 10;
  settings.mHardwareDedicacedTxBufferCount = 0;
  settings.mHardwareTransmitBufferPayload = ACANFD_GIGA_R1_Settings::PAYLOAD_8_BYTES;

  settings.mDriverTransmitFIFOSize = 10;
  settings.mDriverReceiveFIFO0Size = 20;
  settings.mDriverReceiveFIFO1Size = 0;

  // Explicitly use the NEXT shield CANRX/CANTX FDCAN2 pins.
  settings.mTxPin = PB_13;
  settings.mRxPin = PB_5;

  const uint32_t errorCode = VESC_CAN.beginFD(settings);

  PC_SERIAL.print("<BOOT,FDCAN2_RAM_REQUIRED_WORDS=");
  PC_SERIAL.print(VESC_CAN.messageRamRequiredMinimumSize());
  PC_SERIAL.println(">");

  if (errorCode == 0) {
    PC_SERIAL.print("<BOOT,CAN_OK,PERIPHERAL=FDCAN2,BITRATE=");
    PC_SERIAL.print(CAN_BITRATE);
    PC_SERIAL.println(">");
    return true;
  }

  PC_SERIAL.print("<ERR,CAN_BEGIN_FAILED,PERIPHERAL=FDCAN2,CODE=0x");
  PC_SERIAL.print(errorCode, HEX);
  PC_SERIAL.println(">");

  digitalWrite(CAN_STBY_PIN, CAN_STBY_STANDBY_LEVEL);
  return false;
}

// --------------------------------------------------
// VESC CAN wrapper functions
// --------------------------------------------------

bool sendVescCanFrame(uint8_t vescId, uint32_t packetId, const uint8_t* payload, uint8_t len) {
  static unsigned long lastCanErrorPrintMs = 0;

  if (len > 8) {
    pcErr("CAN_PAYLOAD_TOO_LONG");
    return false;
  }

  if (DRY_RUN) {
    PC_SERIAL.print("<DRY,CAN,ID=");
    PC_SERIAL.print(vescId);
    PC_SERIAL.print(",PACKET=");
    PC_SERIAL.print(packetId);
    PC_SERIAL.print(",LEN=");
    PC_SERIAL.print(len);
    PC_SERIAL.print(",DATA=");

    for (uint8_t i = 0; i < len; i++) {
      if (payload[i] < 16) {
        PC_SERIAL.print('0');
      }
      PC_SERIAL.print(payload[i], HEX);
    }

    PC_SERIAL.println(">");
    return true;
  }

  if (!canReady) {
    canTxFailCount++;

    if (driveEnabled || motorRelayActive) {
      canFaultLatched = true;
    }

    pcErr("CAN_NOT_READY");
    return false;
  }

  CANFDMessage frame;
  frame.idx = 0;
  frame.id = makeVescCanId(packetId, vescId);
  frame.ext = true;

  // VESC expects classic CAN data frames, not CAN-FD payload frames.
  frame.type = CANFDMessage::CAN_DATA;

  frame.len = len;

  for (uint8_t i = 0; i < 8; i++) {
    frame.data[i] = 0;
  }

  for (uint8_t i = 0; i < len; i++) {
    frame.data[i] = payload[i];
  }

  lastCanTxStatus = VESC_CAN.tryToSendReturnStatusFD(frame);

  if (lastCanTxStatus != 0) {
    canTxFailCount++;

    if (driveEnabled || motorRelayActive) {
      canFaultLatched = true;
    }

    unsigned long now = millis();

    if (now - lastCanErrorPrintMs > 500) {
      lastCanErrorPrintMs = now;

      PC_SERIAL.print("<ERR,CAN_TX_FAIL,STATUS=0x");
      PC_SERIAL.print(lastCanTxStatus, HEX);

      PC_SERIAL.print(",FLAGS=0x");
      PC_SERIAL.print(getCanFlags(), HEX);

      PC_SERIAL.print(",ID=");
      PC_SERIAL.print(vescId);

      PC_SERIAL.print(",PACKET=");
      PC_SERIAL.print(packetId);

      PC_SERIAL.println(">");
    }

    return false;
  }

  return true;
}

bool sendVescDuty(uint8_t vescId, float duty) {
  duty = clampDuty(duty);

  uint8_t payload[4];
  int32_t scaledDuty = int32_t(lroundf(duty * 100000.0f));
  writeInt32BE(payload, scaledDuty);

  return sendVescCanFrame(vescId, CAN_PACKET_SET_DUTY, payload, sizeof(payload));
}

void sendLeftCommand(float duty) {
  if (DRY_RUN) {
    PC_SERIAL.print("<DRY,L,DUTY=");
    PC_SERIAL.print(duty, 3);
    PC_SERIAL.println(">");
    return;
  }

  sendVescDuty(LEFT_VESC_ID, duty);
}

void sendRightCommand(float duty) {
  if (DRY_RUN) {
    PC_SERIAL.print("<DRY,R,DUTY=");
    PC_SERIAL.print(duty, 3);
    PC_SERIAL.println(">");
    return;
  }

  sendVescDuty(RIGHT_VESC_ID, duty);
}

void refreshVescCommandsBoth() {
  sendVescDuty(LEFT_VESC_ID, leftTarget);
  sendVescDuty(RIGHT_VESC_ID, rightTarget);
}

// --------------------------------------------------
// CAN receive / telemetry
// --------------------------------------------------

void parseVescStatusFrame(const CANFDMessage& frame) {
  if (!frame.ext) {
    return;
  }

  const uint32_t packetId = getVescPacketIdFromCanId(frame.id);
  const uint8_t sourceId = getVescSourceIdFromCanId(frame.id);

  VescTelemetryCache* tel = nullptr;

  if (sourceId == LEFT_VESC_ID) {
    tel = &leftTel;
  } else if (sourceId == RIGHT_VESC_ID) {
    tel = &rightTel;
  } else {
    return;
  }

  canRxCount++;
  tel->lastRxMs = millis();

  if (packetId == CAN_PACKET_STATUS && frame.len >= 8) {
    tel->seenStatus = true;
    tel->rpm = readInt32BE(&frame.data[0]);
    tel->current = float(readInt16BE(&frame.data[4])) / 10.0f;
    tel->duty = float(readInt16BE(&frame.data[6])) / 1000.0f;
    return;
  }

  if (packetId == CAN_PACKET_STATUS_5 && frame.len >= 6) {
    tel->seenStatus5 = true;
    tel->vin = float(readInt16BE(&frame.data[4])) / 10.0f;
    return;
  }
}

void readCan() {
  if (DRY_RUN || !canReady) {
    return;
  }

  CANFDMessage frame;

  while (VESC_CAN.receiveFD0(frame)) {
    parseVescStatusFrame(frame);
  }
}

